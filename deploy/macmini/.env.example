# Postiz on a fresh M4 Mac mini. scripts/gen-secrets.sh copies this file to
# .env and fills JWT_SECRET, POSTGRES_PASSWORD, and TEMPORAL_POSTGRES_PASSWORD.
# It never prints those values. Edit the public hostname and the R2 values
# in .env after that. Do not commit .env.
#
# Placeholder host postiz.example.com is not a real site. Replace it with the
# hostname the Cloudflare Tunnel will serve. No trailing slash on any URL.
# ConfigurationChecker rejects a trailing slash (libraries/helpers/src/configuration/configuration.checker.ts).

# === Public origin (https, the tunnel hostname, not localhost)
MAIN_URL=https://postiz.example.com
FRONTEND_URL=https://postiz.example.com
NEXT_PUBLIC_BACKEND_URL=https://postiz.example.com/api

# Inside the Postiz container, nginx proxies /api to the Nest process on 3000.
# The compose file forces this value. Do not point it at the public hostname.
BACKEND_INTERNAL_URL=http://localhost:3000

# Compose forces these two as well. They are repeated here so a reader of
# .env can see the whole set.
REDIS_URL=redis://postiz-redis:6379
TEMPORAL_ADDRESS=temporal:7233

# Required by the Agents / Dev settings tab and by the upstream compose.
IS_GENERAL=true
# Starts the missing-post Temporal workflow (infinite.workflow.register.ts).
RUN_CRON=true

# Leave false until the first account exists, then set true and recreate
# the postiz container. With no Stripe key, the first local account is
# created even if this is already true and the database is empty
# (auth.service.ts canRegister). Generic OAuth ignores the flag. Leave
# generic OAuth unset.
DISABLE_REGISTRATION=false

# Public create-post calls per organization per hour. See README.
# Upstream compose hardcodes 30. The process default when unset is 90.
# 300 is the kit default: enough for a bot to file a batch of drafts,
# still a cap if a key leaks. It does not throttle MCP, and it is not a
# substitute for keeping the API key on this Mac.
API_LIMIT=300

JWT_SECRET=CHANGE_ME

# === Postgres (Postiz). gen-secrets replaces CHANGE_ME.
# The compose file rebuilds DATABASE_URL from POSTGRES_PASSWORD so the
# hostname stays postiz-postgres, the Docker network name.
POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postiz-db-local
DATABASE_URL=postgresql://postiz-user:CHANGE_ME@postiz-postgres:5432/postiz-db-local

# === Postgres (Temporal). A different password from the Postiz database.
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=CHANGE_ME
TEMPORAL_POSTGRES_DB=temporal

# === Storage. R2, public media on the existing CDN hostname.
# The S3 endpoint is built in code as
# https://${CLOUDFLARE_ACCOUNT_ID}.r2.cloudflarestorage.com
# (libraries/nestjs-libraries/src/upload/cloudflare.storage.ts and r2.uploader.ts).
# CLOUDFLARE_BUCKET_URL is the public prefix prepended to each object key.
# No trailing slash: the code inserts one itself.
# CLOUDFLARE_REGION is passed to the S3 client. R2 expects auto.
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ACCESS_KEY=your-r2-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_BUCKETNAME=your-bucket-name
CLOUDFLARE_BUCKET_URL=https://cdn.magnetbaron.com
CLOUDFLARE_REGION=auto
# Local upload path inside the container. Unused while STORAGE_PROVIDER=cloudflare.
# The uploads volume is still mounted and is included in backups.
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads
# Public API and MCP reject media URLs that do not contain this string
# when it is set (valid.url.path.ts, public.integrations.controller.ts).
RESTRICT_UPLOAD_DOMAINS=cdn.magnetbaron.com

# === Provider apps. Leave empty until you register each app.
# Values are client ids and secrets. They are not generated by gen-secrets.
# Bluesky has no client id. You type an app password into the channel dialog.
# X_URL, when set, replaces FRONTEND_URL as the X OAuth 1.0a callback origin
# (x.provider.ts). Leave it empty so the callback is FRONTEND_URL.

X_URL=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# Leave Stripe unset. STRIPE_PUBLISHABLE_KEY makes a new organization look
# like the FREE plan (users.controller.ts) and hides Settings > Agents / Dev,
# which is where the API key and MCP URL are shown.
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_SIGNING_KEY=

# Leave Resend unset. If RESEND_API_KEY is set, local signup waits for an
# activation email (.env.example at the repo root).
# RESEND_API_KEY=
